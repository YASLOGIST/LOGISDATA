# ---------------------------------------------------------------------
# LOGISDATA Control Room — environment
# Copy to .env.local for local development. Every value below is OPTIONAL;
# the presentation runs with no configuration at all.
# ---------------------------------------------------------------------

# Absolute public origin. Used for canonical URLs, OpenGraph, robots.txt
# and sitemap.xml. Set this in production or those URLs point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Version string reported by GET /api/health.
NEXT_PUBLIC_APP_VERSION=3.0.0

# ---------------------------------------------------------------------
# Database (optional). Only needed if you add database-backed features.
# When DATABASE_URL is unset, /api/health reports "not-configured" and
# still returns 200.
# ---------------------------------------------------------------------
# DATABASE_URL=postgresql://app:change-me@127.0.0.1:5432/logisdata

# Pooled connections per process. Clamped to 1..50, default 10.
# DATABASE_POOL_MAX=10

# Set to "true" to require TLS with certificate verification.
# DATABASE_SSL=false

# ---------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------
# Set to "standalone" to emit .next/standalone for container deploys.
# NEXT_OUTPUT=standalone
