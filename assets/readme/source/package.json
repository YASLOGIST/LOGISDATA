{
  "name": "logisdata-readme-visuals",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Deterministic renderer for the LOGISDATA README hero (GIF + poster) and its outlined-type SVG motion system. YASLOGIST.",
  "scripts": {
    "hero": "node render-hero.mjs",
    "hero:poster": "node render-hero.mjs --poster-only",
    "svg": "node render-svg.mjs",
    "build": "node render-hero.mjs && node render-svg.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@napi-rs/canvas": "^1.0.9",
    "gifenc": "^1.0.3",
    "opentype.js": "^1.3.4"
  },
  "engines": { "node": ">=22.0.0" }
}
